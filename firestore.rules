rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  MissionMarket — Firestore security rules
//
//  Guests browse the app WITHOUT signing in (enterGuestMode reads Firestore
//  unauthenticated), so content collections must stay publicly readable.
//  Everything that writes is locked to the one identity allowed to write it.
//
//  Two rules of thumb used throughout:
//    · a client may only create a document that names ITSELF as the author
//    · a client may only update the exact fields its feature needs, checked
//      with diff().affectedKeys().hasOnly(...) — so "like a proof" can never
//      smuggle in a status change
//
//  Admin is a CUSTOM CLAIM (request.auth.token.admin), never a document field,
//  so it cannot be self-granted. Set it with the Admin SDK:
//    admin.auth().setCustomUserClaims(uid, { admin: true })
//
//  ─────────────────────────────────────────────────────────────────────────
//  ONE THING THESE RULES CANNOT FIX, from where the data lives:
//
//  THE WALLET USED TO BE THE OTHER ONE. It was client-written — balance on
//  users/{uid}, debited and credited by the browser — and no rule could tell a
//  real debit from an invented one. It was REMOVED from the app on 27 Aug 2026
//  rather than guarded, which is the only thing that actually ends that
//  argument. Existing accounts may still carry a leftover wallet field in their
//  private drawer; the migration branch below lets them delete it and nothing
//  writes one any more. Real payments, when they come, get built on a server.
//
//  THE USER DOCUMENT IS WORLD-READABLE, and always will be — public profiles
//     need name, username, photo and bio from it, and Firestore has no
//     field-level read control. DONE: email, dateOfBirth, ageVerifiedAt,
//     underageBlocked, blockedAt, wallet and the ban now live in
//     users/{uid}/private/main — and so do settings, acceptedDares,
//     pinnedDares and likedProofs, which were the last four to move. A stranger
//     now reads only name, username, photoURL, bio, website, socials.
//     NOTE: those key names must STAY in the users update rule below. Deleting
//     a field counts as touching it, so removing them from that list would stop
//     an un-migrated account from ever clearing its old public copy.
//
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────
    function signedIn()   { return request.auth != null; }
    function uid()        { return request.auth.uid; }
    function isSelf(u)    { return signedIn() && uid() == u; }
    function isAdmin()    { return signedIn() && request.auth.token.admin == true; }

    // A ban lives in the owner's private drawer, which clients cannot read.
    // Rules-internal get() is not subject to that restriction, so the check
    // works — at the cost of one extra document read on every gated write,
    // which is the price of enforcing it server-side rather than trusting the
    // client. exists() first: an account with no private document is not banned.
    function isBanned() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(uid())/private/main)
          && get(/databases/$(database)/documents/users/$(uid())/private/main).data.get('banned', false) == true;
    }

    // A text field a person types into, kept to a sane length. users/{uid} and
    // dares are world-readable, so an unbounded string is not just this account's
    // problem: a 1 MB bio is downloaded by everyone who opens that profile, and
    // billed to the project every time. Absent is fine — these are all optional.
    function textOk(v, max) { return v == null || (v is string && v.size() <= max); }

    // Same idea for a LIST of strings and for a MAP's values. Rules cannot walk
    // a list element by element, but List.join() and Map.values() turn either
    // one into a single string, and one length check then covers both "too many
    // entries" and "one enormous entry".
    // Why this exists: textOk was guarding eight named fields and nothing else,
    // so every OTHER field on every collection had no ceiling at all. Checked
    // against the live rules from an ordinary account: 50KB went into socials,
    // settings, pinnedDares, likedProofs, a mission's tags and creator name, a
    // proof's note and takerName, a comment's userName and a report's reason —
    // eleven for eleven. /users, /dares, /proofs and /comments are all
    // world-readable and pulled by the feed, so each one of those is a payload
    // downloaded by everybody afterwards.
    // The owner found this from the other end: raising maxlength in the browser
    // inspector and typing past the form's limit. The form is a convenience,
    // never a control — these are the control.
    function listOk(v, max)  { return v == null || (v is list && v.join('|').size() <= max); }
    function mapOk(v, max)   { return v == null || (v is map  && v.values().join('|').size() <= max); }
    function numOk(v, lo, hi){ return v == null || (v is number && v >= lo && v <= hi); }

    // A counter has to START at zero. stepped() guards how a counter MOVES, and
    // says nothing about what it was born as — so a mission could be created
    // with likeCount: 1000000 and sit at the top of "most liked" without ever
    // touching the update rule it was supposed to have to get past. The
    // comments rule already required likeCount == 0 on create; dares and proofs
    // never did. Absent reads as 0, so nothing legitimate has to set them.
    function zeroStart(f) { return request.resource.data.get(f, 0) == 0; }
    function countersStartAtZero() {
      return zeroStart('likeCount') && zeroStart('dislikeCount')
          && zeroStart('viewCount') && zeroStart('commentCount')
          && zeroStart('takers')    && zeroStart('proofCount');
    }

    // keys this update is trying to change
    function touched()    { return request.resource.data.diff(resource.data).affectedKeys(); }
    // the update touches nothing outside `allowed`
    function onlyTouches(allowed) { return touched().hasOnly(allowed); }

    // A counter that moved by at most one step, and never below zero — blocks
    // "likeCount = 1000000". Map.get(key, default) keeps documents that predate
    // the field working (a missing counter reads as 0).
    function prev(field) { return resource.data.get(field, 0); }
    function next(field) { return request.resource.data.get(field, 0); }
    function stepped(field) {
      return !touched().hasAny([field])
          || (next(field) is number
              && next(field) >= 0
              && (next(field) - prev(field)) <=  1
              && (next(field) - prev(field)) >= -1);
    }
    function steppedAll() {
      return stepped('likeCount') && stepped('dislikeCount') && stepped('viewCount');
    }

    // A "who liked this" list may only ever gain or lose the CALLER'S OWN uid.
    //
    // stepped() guards the counter beside these lists and nothing guarded the
    // lists themselves — not their type, not their size, not what went into
    // them. Any signed-in account could therefore write
    //   likedBy: ['<900KB of text>'], likeCount: <current + 1>
    // on any mission and pass every check. Firestore caps a document at 1MB, so
    // that bloats the document until no further update fits — nobody can like,
    // view or count it again — and because /dares and /proofs are world-readable
    // and the feed pulls them, EVERY visitor then downloads that payload. Broken
    // for everyone and billed to the project: the "economic denial of service"
    // in finding #23, and it was real.
    //
    // Written as a set difference in both directions rather than a size cap,
    // because a popular mission legitimately has a long list and a cap would
    // eventually refuse honest likes:
    //   next minus prev = what this write ADDS    → only my own uid, or nothing
    //   prev minus next = what this write REMOVES → only my own uid, or nothing
    // The size check on top of that is not redundant: hasOnly() is happy with
    // [uid, uid, uid, …], so without it the same bloat could be built out of
    // fifty thousand copies of one legitimate value.
    //
    // It closes a smaller hole in passing: until now anyone could delete other
    // people's uids out of these lists, or add somebody else's.
    // prev()/next() default a missing field to 0, which is right for a counter
    // and wrong for a list: on a mission that has never been liked, likedBy does
    // not exist yet, and .size() on the number 0 would throw and refuse the very
    // first like. These two default to an empty list instead.
    function prevList(field) { return resource.data.get(field, []); }
    function nextList(field) { return request.resource.data.get(field, []); }
    function selfOnlyList(field) {
      return !touched().hasAny([field])
          || (nextList(field) is list
              && nextList(field).size() <= prevList(field).size() + 1
              && nextList(field).removeAll(prevList(field)).hasOnly([uid()])
              && prevList(field).removeAll(nextList(field)).hasOnly([uid()]));
    }
    function likeListsOk() {
      return selfOnlyList('likedBy') && selfOnlyList('dislikedBy');
    }
    // Known and accepted: the app's count-repair helpers (_ddRepairCounts,
    // _vdRepairCounts) reset a negative stored counter straight to 0, which is a
    // jump of more than one step and so is refused for anyone who is not the
    // owner. Both calls are .catch()'d best-effort repairs, so the repair simply
    // does not apply — nothing breaks. Loosening the step check to let them
    // through would also let anyone write likeCount = 1000000.

    // ─── users ────────────────────────────────────────────────────────────
    // Public read: guests and the feed need names/avatars/usernames.
    match /users/{userId} {
      allow read: if true;

      // The uid is what matters, and now it is the ONLY thing checked.
      //
      // This used to also require the document's email to match the token's.
      // That was fine until email moved into private/main — after which the app
      // stopped writing email here at all, the condition could never be true,
      // and every new sign-up was refused its public document. The account
      // existed in Auth with no profile behind it. Caught by a fresh sign-up
      // failing with permission-denied inside initUser.
      allow create: if isSelf(userId);

      // Only the account owner, and only the fields the UI actually edits.
      // email, dateOfBirth, ageVerifiedAt, underageBlocked, blockedAt and wallet
      // are NOT here any more — they live in private/main below, because this
      // document is world-readable and those are nobody else's business.
      allow update: if (isSelf(userId)
                        && onlyTouches([
                             'name','username','bio','website','socials','photoURL',
                             'settings','acceptedDares','pinnedDares',
                             'likedProofs','fcmUpdatedAt'
                           ])
                        // and nothing enormous in any of them — the form caps
                        // these at 60/30/160/40, so the ceilings here are well
                        // clear of anything the app itself writes
                        && textOk(request.resource.data.get('name', null), 100)
                        && textOk(request.resource.data.get('username', null), 40)
                        && textOk(request.resource.data.get('bio', null), 300)
                        && textOk(request.resource.data.get('website', null), 300)
                        && textOk(request.resource.data.get('photoURL', null), 800)
                        // The rest of the whitelist had no ceiling at all.
                        // socials is three handles; settings is six switches;
                        // the last three are legacy copies kept here only so an
                        // un-migrated account can delete them.
                        && mapOk(request.resource.data.get('socials', null), 400)
                        && mapOk(request.resource.data.get('settings', null), 400)
                        && listOk(request.resource.data.get('pinnedDares', null), 2000)
                        && listOk(request.resource.data.get('likedProofs', null), 40000)
                        && (!('acceptedDares' in request.resource.data)
                            || request.resource.data.acceptedDares.size() <= 500))
                    // One-way migration: an existing account may REMOVE the old
                    // top-level copies once they have been written to private/.
                    // Removal only — none of them may survive the write, so this
                    // branch can never be used to set or change one.
                    || (isSelf(userId)
                        && onlyTouches(['email','dateOfBirth','ageVerifiedAt',
                                        'underageBlocked','blockedAt','wallet'])
                        && !('email'           in request.resource.data)
                        && !('dateOfBirth'     in request.resource.data)
                        && !('ageVerifiedAt'   in request.resource.data)
                        && !('underageBlocked' in request.resource.data)
                        && !('blockedAt'       in request.resource.data)
                        && !('wallet'          in request.resource.data));

      allow delete: if isSelf(userId) || isAdmin();

      // Owner-only drawer: email, date of birth, age verification and the wallet.
      // NOT a plain read/write — the age check has to keep the same one-way
      // guarantees it had while these fields lived on the public document, or
      // moving them here would quietly hand every blocked account the undo
      // button. Delete is refused outright for the same reason: dropping the
      // document would drop the block with it.
      match /private/{docId} {
        // An admin reads it to answer a support question and writes it to ban,
        // unban or lift a wrong age block — the account holder cannot do the
        // last two for itself, by design, so the admin path has to exist.
        allow read:   if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId);
        allow update: if isAdmin()
                      || isSelf(userId)
                      && (!touched().hasAny(['dateOfBirth'])
                          || resource.data.get('dateOfBirth', null) == null)
                      && (!touched().hasAny(['underageBlocked'])
                          || request.resource.data.underageBlocked == true)
                      // same shape as the age block: an account may not lift
                      // its own suspension
                      && (!touched().hasAny(['banned'])
                          || request.resource.data.banned == true);
        allow delete: if false;
      }
      // Push tokens: the owner registers them, only Functions read them.
      match /tokens/{token} {
        allow read, write: if isSelf(userId);
      }
    }

    // ─── usernames (handle reservations) ──────────────────────────────────
    // Doc id IS the handle. Create only if free; you may only release your own.
    match /usernames/{handle} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == uid()
                    && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == uid();
      allow update: if false;   // release + reserve, never rewrite in place
    }

    // ─── dares (missions) ─────────────────────────────────────────────────
    match /dares/{dareId} {
      allow read: if true;

      // The caption and description are shown on a card built for one line and a
      // short paragraph. The post form caps them at 120 and 2000.
      function dareTextOk() {
        return textOk(request.resource.data.get('caption', null), 200)
            && textOk(request.resource.data.get('title', null), 200)
            && textOk(request.resource.data.get('description', null), 4000)
            // Everything else the card carries. The feed downloads these for
            // every mission it shows, so an unbounded one is everyone's problem.
            && textOk(request.resource.data.get('creator', null), 100)
            && textOk(request.resource.data.get('creatorUsername', null), 60)
            && textOk(request.resource.data.get('creatorPhotoURL', null), 800)
            && textOk(request.resource.data.get('thumbnailURL', null), 800)
            && textOk(request.resource.data.get('cat', null), 60)
            // The post form allows 5 tags of 30 characters.
            && listOk(request.resource.data.get('tags', null), 300)
            && listOk(request.resource.data.get('rules', null), 2000)
            // MIN_REWARD and MAX_REWARD are 1 and 1,000,000 — in app.js only,
            // so 999999999 went straight in and showed as a real bounty.
            && numOk(request.resource.data.get('rewardAmount', null), 0, 1000000)
            && numOk(request.resource.data.get('bounty', null), 0, 1000000);
      }
      allow create: if signedIn() && !isBanned()
                    && request.resource.data.creatorUid == uid()
                    && request.resource.data.completed == false
                    && countersStartAtZero()
                    && dareTextOk();

      // Once anyone has accepted, the deal is struck. A creator dropping the
      // reward from 500 to 1 after a taker has already filmed is a scam, not an
      // edit, and the rules were letting the owner rewrite anything at any time.
      // Running a live mission still needs a few keys, so those stay open.
      function dareTaken() {
        return resource.data.get('takers', 0) > 0
            || resource.data.get('approvedTakers', []).size() > 0;
      }
      // Checked against every dare write the app actually makes:
      // choosing takers, the accept counter, the proof counter, closing the
      // mission, the expiry refund flag, and likes. 'refunded' is bookkeeping,
      // not a term of the deal, so it stays open.
      function whileRunning() {
        return ['approvedTakers','takers','proofCount','completed','refunded',
                'likedBy','likeCount','dislikedBy','dislikeCount','viewCount'];
      }
      allow update: if
        // the owner may edit their own mission — freely until it is taken,
        // and after that only the keys that running it requires
        // likeListsOk() applies here too. A creator has no legitimate reason to
        // write anyone's like into their own mission, and without it the owner
        // branch was a way straight past the guard on the public branch below —
        // on a mission everyone downloads, which is the whole point of #23.
        (signedIn() && resource.data.creatorUid == uid()
                    && dareTextOk()
                    && likeListsOk()
                    && (!dareTaken() || onlyTouches(whileRunning())))
        // A creator clearing the legacy creatorEmail off an old mission. It is
        // removal only — the field may not survive the write — so this can never
        // put an address back, and a taken mission must not be exempt from a
        // privacy cleanup.
        || (signedIn() && resource.data.creatorUid == uid()
                       && onlyTouches(['creatorEmail'])
                       && !('creatorEmail' in request.resource.data))
        // everyone else may only move engagement counters, one step at a time.
        // takers and proofCount are in this list but steppedAll() never checked
        // them — it only covers the three like/view counters — so anyone signed
        // in could write takers: 1000000 on any mission and make it look wildly
        // popular. Checked explicitly here rather than inside steppedAll(),
        // which is also used by /proofs where neither field exists.
        || (signedIn() && onlyTouches([
              'likedBy','likeCount','dislikedBy','dislikeCount',
              'viewCount','takers','proofCount'
            ]) && steppedAll()
              && stepped('takers') && stepped('proofCount')
              && likeListsOk())
        // guests still count a view
        || (onlyTouches(['viewCount']) && stepped('viewCount'));

      allow delete: if (signedIn() && resource.data.creatorUid == uid()) || isAdmin();

      // ─── applicants (who accepted this mission) ───
      match /applicants/{applicantId} {
        function isDareOwner() {
          return signedIn()
              && exists(/databases/$(database)/documents/dares/$(dareId))
              && get(/databases/$(database)/documents/dares/$(dareId)).data.creatorUid == uid();
        }

        allow read:   if isSelf(applicantId) || isDareOwner();
        allow create: if isSelf(applicantId) && !isBanned()
                      && request.resource.data.uid == uid()
                      && request.resource.data.status in ['pending','accepted'];
        // Approve / reject — and ONLY that. Without the field restriction the
        // mission owner could rewrite the whole applicant record, including the
        // uid it belongs to, which would quietly detach someone from their own
        // application. The app writes nothing here but status.
        allow update: if isDareOwner() && onlyTouches(['status']);
        allow delete: if isSelf(applicantId) || isDareOwner();
      }
    }

    // ─── proofs (submitted videos) ────────────────────────────────────────
    match /proofs/{proofId} {
      allow read: if true;

      // Only someone the creator picked may send proof. This mirrors the check
      // in openProof(), which is a button and therefore not a control.
      // Missions posted before creator-picks became the only mode stay open, so
      // anyone part-way through one is not locked out of finishing it.
      // Written without a `let` binding on purpose — the same get() twice reads
      // the document once per evaluation, and this file is published by hand,
      // so the plainest syntax that cannot be argued with wins.
      function mayProve(dareId) {
        return get(/databases/$(database)/documents/dares/$(dareId))
                 .data.get('takerSelectionMode', 'open') != 'creator_picks'
            || uid() in get(/databases/$(database)/documents/dares/$(dareId))
                 .data.get('approvedTakers', []);
      }
      // A finished mission takes no more proof. approveProof() writes
      // completed:true on the mission, but nothing here used to read it, so an
      // already-approved taker could keep submitting afterwards — and this was
      // reachable by pressing a normal button, not only by a crafted request:
      // a completed mission leaves the missions feed but stays on the Accepted
      // page of everyone who took it, Submit Proof still live.
      // It matters more than one stray document. The update rule below judges
      // each proof on its own and cannot see that a sibling was already
      // approved, so the creator could approve a SECOND proof and leave two
      // people recorded as having completed one bounty. Nothing is paid today
      // only because WALLET_ENABLED is false — which is exactly why this closes
      // before that flag moves, not after.
      // Defaulted with .get() so a mission written before the field existed
      // reads as not completed rather than failing the write.
      function missionOpen(dareId) {
        return get(/databases/$(database)/documents/dares/$(dareId))
                 .data.get('completed', false) == false;
      }
      // A proof carries a copy of everything needed to draw its card, and none
      // of it was bounded. The feed reads this collection.
      function proofTextOk() {
        return textOk(request.resource.data.get('note', null), 2000)
            && textOk(request.resource.data.get('takerName', null), 100)
            && textOk(request.resource.data.get('takerUsername', null), 60)
            && textOk(request.resource.data.get('takerPhotoURL', null), 800)
            && textOk(request.resource.data.get('posterName', null), 100)
            && textOk(request.resource.data.get('posterUsername', null), 60)
            && textOk(request.resource.data.get('posterPhotoURL', null), 800)
            && textOk(request.resource.data.get('dareTitle', null), 300)
            && textOk(request.resource.data.get('videoURL', null), 800)
            && textOk(request.resource.data.get('proofThumbnailURL', null), 800)
            && textOk(request.resource.data.get('videoFilename', null), 300)
            && textOk(request.resource.data.get('videoSize', null), 40)
            && textOk(request.resource.data.get('cat', null), 60)
            && textOk(request.resource.data.get('rejectionReason', null), 1000)
            && numOk(request.resource.data.get('dareBounty', null), 0, 1000000);
      }
      allow create: if signedIn() && !isBanned()
                    && request.resource.data.takerId == uid()
                    && request.resource.data.status == 'submitted'
                    && countersStartAtZero()
                    && proofTextOk()
                    && exists(/databases/$(database)/documents/dares/$(request.resource.data.dareId))
                    && missionOpen(request.resource.data.dareId)
                    && mayProve(request.resource.data.dareId);

      allow update: if
        // ONLY the mission owner may judge a proof, and ONLY once. Without the
        // check on the previous status the owner could flip approved → rejected
        // → approved without limit, firing a notification and (later) a payout
        // every time. A rejected taker submits a NEW proof document, so nothing
        // legitimate needs to reopen this one.
        (signedIn() && resource.data.posterId == uid()
                    && onlyTouches(['status','rejectionReason'])
                    && resource.data.status == 'submitted'
                    && request.resource.data.status in ['approved','rejected'])
        // anyone signed in may like / dislike / recount comments
        // (commentCount is a full recount from a query, so it is not step-checked)
        || (signedIn() && onlyTouches([
              'likeCount','likedBy','dislikeCount','dislikedBy','commentCount','viewCount'
            ]) && steppedAll() && likeListsOk())
        // guests still count a view
        || (onlyTouches(['viewCount']) && stepped('viewCount'))
        // One-way cleanup: proofs used to store both parties' email addresses,
        // and this collection is world-readable. Either party may REMOVE those
        // fields from a proof they are part of. Removal only — neither may
        // survive the write, so this can never be used to set one.
        || (signedIn()
            && (resource.data.takerId == uid() || resource.data.posterId == uid())
            && onlyTouches(['takerEmail','posterEmail'])
            && !('takerEmail'  in request.resource.data)
            && !('posterEmail' in request.resource.data));

      // The taker who filmed it, or an admin. NOT the mission creator: letting
      // posterId delete meant a creator could ask for proof, wait for it to be
      // submitted, then make it disappear rather than pay — and it went around
      // the one-way judgement above, since a deleted proof has no verdict at
      // all. Nothing in the app ever called this; the permission was open with
      // no feature behind it. A creator who does not want a proof rejects it,
      // which leaves a record.
      allow delete: if (signedIn() && resource.data.takerId == uid())
                    || isAdmin();
    }

    // ─── comments ─────────────────────────────────────────────────────────
    match /comments/{commentId} {
      // A comment's proofId holds a PROOF id on a video and a DARE id on a
      // mission — one collection serves both surfaces — so a pin check has to
      // try both, each behind exists() or the get() blows up on the other kind.
      // Video: the taker who made it OR the creator who paid for it may pin.
      // Mission: the creator may pin. Both match _ddCanPin in the app.
      function pinnerOfProof() {
        return exists(/databases/$(database)/documents/proofs/$(resource.data.proofId))
            && (get(/databases/$(database)/documents/proofs/$(resource.data.proofId)).data.takerId == uid()
             || get(/databases/$(database)/documents/proofs/$(resource.data.proofId)).data.get('posterId','') == uid());
      }
      function pinnerOfDare() {
        return exists(/databases/$(database)/documents/dares/$(resource.data.proofId))
            && get(/databases/$(database)/documents/dares/$(resource.data.proofId)).data.creatorUid == uid();
      }

      allow read: if true;

      // The thing being commented on has to be real. Without this a comment
      // could carry proofId:"fake123" — invisible, since no screen queries that
      // id, but stored and billed forever. Same both-collections dance as the
      // pin check above: one id field serves videos and missions.
      // Costs up to two document reads per comment posted. That is the price of
      // the check and it is worth it at this volume; it is also why this is not
      // done on likes, which are far more frequent and carry no id of their own.
      function commentTargetExists(id) {
        return exists(/databases/$(database)/documents/proofs/$(id))
            || exists(/databases/$(database)/documents/dares/$(id));
      }
      allow create: if signedIn() && !isBanned()
                    && request.resource.data.userId == uid()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.likeCount == 0
                    // text was capped; the name and picture beside it were not
                    && textOk(request.resource.data.get('userName', null), 100)
                    && textOk(request.resource.data.get('userPhotoURL', null), 800)
                    && commentTargetExists(request.resource.data.proofId);

      allow update: if
        // The author may edit their own text — within the same 500 the create
        // rule enforces. Without repeating it here, the cap was a formality:
        // post "hi", then edit that comment to a megabyte. Comments are
        // world-readable and pulled per video, so the bloat lands on every
        // viewer afterwards. Gemini caught this; it is the same shape as #23
        // reached through the edit door instead of the create one.
        (signedIn() && resource.data.userId == uid()
                    && onlyTouches(['text','edited','editedAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500)
        // anyone may like it
        || (signedIn() && onlyTouches(['likedBy','likeCount']) && stepped('likeCount')
            && selfOnlyList('likedBy'))
        // pin / unpin, by whoever owns the thing being commented on
        || (signedIn()
            && onlyTouches(['pinned','pinnedBy'])
            && (pinnerOfProof() || pinnerOfDare()));

      // Author, admin — and whoever owns the thing being commented on, which is
      // the same test that decides who may pin. Without it a creator could not
      // remove an abusive comment sitting under their own mission; they could
      // pin it but not delete it, which is a strange half-power to hand someone.
      allow delete: if (signedIn() && resource.data.userId == uid())
                    || (signedIn() && (pinnerOfProof() || pinnerOfDare()))
                    || isAdmin();
    }

    // ─── follows ──────────────────────────────────────────────────────────
    // Doc id is "<follower>_<target>_<type>", so the id itself is checked to
    // stop anyone forging a follow on someone else's behalf.
    match /follows/{followId} {
      allow read: if true;
      // The person being followed has to exist. A follow pointing at a made-up
      // uid could never add a follower to a real account — followerUid is
      // pinned to the signed-in user and the document id is checked — so this
      // only ever inflated the follower's OWN "following" number and left a row
      // nobody could see. Still junk that is stored and billed; one read stops
      // it, and following someone is a rare enough action to afford that.
      allow create: if signedIn()
                    && request.resource.data.followerUid == uid()
                    && request.resource.data.targetUid != uid()
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid))
                    && followId == uid() + '_' + request.resource.data.targetUid + '_' + request.resource.data.type;
      allow delete: if signedIn() && resource.data.followerUid == uid();
      allow update: if false;
    }

    // ─── reports (abuse) ──────────────────────────────────────────────────
    // Write-only for users: you can file one, you can never read the queue.
    match /reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterUid == uid()
                    && request.resource.data.status == 'pending'
                    // the report form allows 500 characters
                    && textOk(request.resource.data.get('reason', null), 2000)
                    && textOk(request.resource.data.get('targetName', null), 300)
                    && textOk(request.resource.data.get('reporterName', null), 100)
                    && textOk(request.resource.data.get('reporterEmail', null), 200);
      allow update, delete: if isAdmin();
    }

    // ─── notifications ────────────────────────────────────────────────────
    // Clients CANNOT create these. Cloud Functions write them through the
    // Admin SDK, which bypasses rules — that is the whole point: otherwise any
    // user could post any message to any other user's bell.
    match /notifications/{notifId} {
      allow read:   if signedIn() && resource.data.toUserId == uid();
      allow create: if false;
      allow update: if signedIn() && resource.data.toUserId == uid()
                    && onlyTouches(['read'])
                    && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.toUserId == uid();
    }

    // ─── search term counters (trending) ──────────────────────────────────
    // Public read, but a signed-in client may only nudge a count by one.
    match /searches/{term} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['term','count'])
                    && request.resource.data.count == 1;
      allow update: if signedIn()
                    && onlyTouches(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // ─── agreements — LEGAL AUDIT TRAIL ───────────────────────────────────
    // What a person accepted, when, and the hash of the exact wording they were
    // shown. The app never reads these back — they exist for a dispute — so the
    // client can write one and nothing else.
    //
    // Without this block the collection falls to the default deny below, and
    // because every gate writes its record BEFORE the action and refuses to
    // continue if that write fails, that would stop anyone posting a mission,
    // accepting one, or submitting proof. It is not an optional section.
    //
    // The one permitted edit is the link to what the agreement authorised: a
    // creator agreement is recorded before the mission exists and a proof
    // agreement before the proof does, so each starts with a null id. Only
    // those two fields, only by the person who signed it, and only while still
    // null — the consent itself can never be rewritten.
    match /agreements/{agreementId} {
      allow read: if isAdmin();

      allow create: if signedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.type in
                         ['mission_create','mission_accept','proof_submission']
                    && request.resource.data.agreementVersion is string
                    && request.resource.data.agreementHash is string;

      allow update: if signedIn()
                    && resource.data.userId == uid()
                    && onlyTouches(['missionId','proofId'])
                    && (!touched().hasAny(['missionId']) || resource.data.get('missionId', null) == null)
                    && (!touched().hasAny(['proofId'])   || resource.data.get('proofId',   null) == null);

      allow delete: if false;
    }

    // ─── safety filter logs ───────────────────────────────────────────────
    // Write-only for clients, and deliberately so: someone who just got blocked
    // must not be able to read the queue back, because that is a list of the
    // words to avoid next time.
    match /safety_blocks/{id} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // The two AI reviewers disagreed about whether a mission is safe. A human
    // decides, so an admin needs to be able to work the queue.
    match /manual_review/{id} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ─── feedback ─────────────────────────────────────────────────────────
    // Write-only for users, admin-read. Nobody browses other people's
    // complaints, and nobody edits one after sending it.
    match /feedback/{id} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == uid()
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // ─── admin action log ─────────────────────────────────────────────────
    // Append-only, even for the admin who wrote it. A moderation log that can
    // be edited afterwards answers no question worth asking.
    match /admin_actions/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == uid();
      allow update, delete: if false;
    }

    // ─── default deny ─────────────────────────────────────────────────────
    // Anything not matched above is refused, including future collections.
    // NOTE: that cuts both ways — adding a collection to the app without adding
    // it here silently breaks the feature. agreements/safety_blocks/manual_review
    // above were exactly that, added to the app after these rules were written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
